DATABASE_URL=postgresql+psycopg2://signalhub:signalhub@db:5432/signalhub

# Optional. Powers POST /extraction/infer, which the browser extension uses
# to pre-fill company/role/location/status from the page you're on. Without
# it, that endpoint still works but falls back to the extension's local
# JobPosting/heuristic extraction (no status inference).
ANTHROPIC_API_KEY=
